<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="connection.url">jdbc:mysql://localhost:3306/smart_library?useSSL=false&amp;serverTimezone=UTC</property>
        <property name="connection.username">librarySuprakash</property>
        <property name="connection.password">Suprakash2006</property>
        <property name="dialect">org.hibernate.dialect.MySQLDialect</property>
        <property name="hbm2ddl.auto">update</property>
        <property name="show_sql">true</property>
        
        <!-- Entity Mappings -->
        <mapping class="com.mycompany.smartlibrary.model.Specialization"/>
        <mapping class="com.mycompany.smartlibrary.model.Author"/>
        <mapping class="com.mycompany.smartlibrary.model.Category"/>
        <mapping class="com.mycompany.smartlibrary.model.Book"/>
        <mapping class="com.mycompany.smartlibrary.model.BookIssue"/>
        <mapping class="com.mycompany.smartlibrary.model.User"/>
        <mapping class="com.mycompany.smartlibrary.model.BookRequest"/>
<mapping class="com.mycompany.smartlibrary.model.Member"/>
<mapping class="com.mycompany.smartlibrary.model.Fine"/>
    </session-factory>
</hibernate-configuration>